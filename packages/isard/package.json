{
  "name": "@ign-junn/isard",
  "version": "0.1.1",
  "description": "WebGL2 map engine for large, interactive data layers, labels and 3D Tiles on Géoplateforme basemaps, raster or vector (Rust core in WebAssembly)",
  "license": "MIT",
  "author": "Institut national de l'information géographique et forestière (IGN)",
  "keywords": [
    "map",
    "webgl2",
    "webassembly",
    "geoplateforme",
    "ign",
    "3d-tiles",
    "vector-tiles",
    "network",
    "accessibility",
    "flood"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./decoder.worker.js": "./dist/decoder.worker.js",
    "./basemap.worker.js": "./dist/basemap.worker.js",
    "./isard_bg.wasm": "./dist/isard_bg.wasm"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
