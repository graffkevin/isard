{
  "name": "isard",
  "version": "0.6.1",
  "description": "A WebGL2 map engine for large, interactive data layers, labels and 3D Tiles over raster or vector basemaps (Rust core in WebAssembly)",
  "license": "MIT",
  "author": "Kevin Graff",
  "homepage": "https://graffkevin.github.io/isard/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/graffkevin/isard.git",
    "directory": "packages/isard"
  },
  "bugs": "https://github.com/graffkevin/isard/issues",
  "keywords": [
    "map",
    "webgl2",
    "webassembly",
    "3d-tiles",
    "vector-tiles",
    "openstreetmap",
    "geoplateforme",
    "network",
    "accessibility",
    "flood"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "isard-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./formats": {
      "isard-source": "./src/formats.ts",
      "types": "./dist/formats.d.ts",
      "default": "./dist/formats.js"
    },
    "./projections": {
      "isard-source": "./src/projections.ts",
      "types": "./dist/projections.d.ts",
      "default": "./dist/projections.js"
    },
    "./geoplateforme": {
      "isard-source": "./src/geoplateforme.ts",
      "types": "./dist/geoplateforme.d.ts",
      "default": "./dist/geoplateforme.js"
    },
    "./decoder.worker.js": "./dist/decoder.worker.js",
    "./basemap.worker.js": "./dist/basemap.worker.js",
    "./isard_bg.wasm": "./dist/isard_bg.wasm",
    "./isard_core_bg.wasm": "./dist/isard_core_bg.wasm",
    "./isard_points_bg.wasm": "./dist/isard_points_bg.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
