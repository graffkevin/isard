{
  "name": "isard",
  "version": "0.1.0",
  "description": "WebGL2 map engine for large, interactive data layers and 3D Tiles on Géoplateforme basemaps (Rust core in WebAssembly)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./decoder.worker.js": "./dist/decoder.worker.js",
    "./basemap.worker.js": "./dist/basemap.worker.js",
    "./isard_bg.wasm": "./dist/isard_bg.wasm"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false
}
