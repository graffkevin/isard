# Copy to .env (ignored by git) and paste the npm token after the "=".
# npmjs.com > Access Tokens > Generate New Token > Granular Access Token:
# "Read and write" on the ign-junn organization, "Bypass two-factor authentication" ticked, 90 days at most.
# `bun run release` loads this file; packages/isard/.npmrc reads the token from NPM_TOKEN.
NPM_TOKEN=
