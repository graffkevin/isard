{
  "name": "isard-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples",
    "docs"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "dev": "bun scripts/build.ts && bun scripts/serve.ts",
    "typecheck": "tsc -p packages/isard && tsc -p packages/isard/tsconfig.worker.json && tsc -p apps/demo && tsc -p apps/bench && tsc -p examples && tsc -p scripts",
    "lint": "biome check . && cargo clippy --all-targets && cargo clippy --target wasm32-unknown-unknown",
    "format": "biome check --write . && cargo fmt",
    "test": "cargo test",
    "release": "bun scripts/release.ts",
    "release:dry": "bun scripts/release.ts --dry-run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "^1.4.3",
    "binaryen": "^132.0.0",
    "typescript": "~6.0.2"
  },
  "overrides": {
    "3d-tiles-renderer": "0.5.3"
  }
}
